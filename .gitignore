# ==========================================================
# Data
#
# Keep folder structure and metadata under version control.
# Ignore the actual dataset files.
# ==========================================================

# Raw datasets
data/raw/**/*.csv
data/raw/**/*.tsv
data/raw/**/*.txt
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.arff
data/raw/**/*.data
data/raw/**/*.dat
data/raw/**/*.jsonl
data/raw/**/*.parquet
data/raw/**/*.feather
data/raw/**/*.h5
data/raw/**/*.hdf5
data/raw/**/*.zip
data/raw/**/*.gz
data/raw/**/*.7z
data/raw/**/*.rar
data/raw/**/*.tar
data/raw/**/*.tgz

# Processed datasets
data/processed/**/*.csv
data/processed/**/*.tsv
data/processed/**/*.txt
data/processed/**/*.xlsx
data/processed/**/*.xls
data/processed/**/*.parquet
data/processed/**/*.feather
data/processed/**/*.pkl
data/processed/**/*.joblib
data/processed/**/*.npy
data/processed/**/*.npz

# Keep documentation and metadata
!data/README.md
!data/raw/**/metadata.json
!data/raw/**/.gitkeep
!data/processed/**/.gitkeep

# ==========================================================
# Experiment Outputs
# ==========================================================

# Ignore everything generated during benchmarking
results/**

# Keep directory structure
!results/.gitkeep

# ==========================================================
# Trained Models
#
# Uncomment if models are stored locally.
# ==========================================================

# models/**
# !models/.gitkeep

# ==========================================================
# MLflow (if used locally)
# ==========================================================

mlruns/
mlartifacts/
mlflow.db

# ==========================================================
# Environment Files
# ==========================================================

.env.local

# ==========================================================
# Editor History
# ==========================================================

.history/

# ==========================================================
# Miscellaneous
# ==========================================================

*.pid
*.seed

# ==========================================================
# Generated Reports
# ==========================================================
data/reports/*
!data/reports/.gitkeep